<section class="page-head">
  <div>
    <h1>Events</h1>
    <p class="lede">Upcoming experiences you can browse, vote on, and open on Billetto.</p>
  </div>
</section>

<% unless current_user %>
  <div class="callout">
    <p><em>Sign in to vote on events.</em></p>
    <button type="button" class="btn" id="clerk-sign-in-banner">Sign in to vote</button>
  </div>
<% end %>

<% if @events.empty? %>
  <div class="empty-state">
    <h2>No events just yet</h2>
    <p>When Billetto events are ingested, they will show up here.</p>
  </div>
<% else %>
  <ul class="event-list">
    <% @events.each do |event| %>
      <li>
        <%= render "events/event", event: event %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @page > 1 || @has_next %>
  <nav class="pagination" aria-label="Pagination">
    <% if @page > 1 %>
      <%= link_to "Previous", events_path(page: @page - 1) %>
    <% end %>
    <% if @has_next %>
      <%= link_to "Next", events_path(page: @page + 1) %>
    <% end %>
  </nav>
<% end %>
