  <!DOCTYPE html>
  <html>
    <head>
      <title>Billetto</title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>

      <script async crossorigin="anonymous"
        src="https://useful-snipe-29.clerk.accounts.dev/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
        data-clerk-publishable-key="<%= ENV['CLERK_PUBLISHABLE_KEY'] %>">
      </script>
    </head>

    <body>
      <nav style="padding: 1rem; background: #f5f5f5; margin-bottom: 1rem; display: flex; justify-content:
  space-between; align-items: center;">
        <strong>Billetto Events</strong>
        <div id="clerk-auth"></div>
      </nav>

      <%= yield %>

      <script>
        window.addEventListener('load', async function () {
          await Clerk.load();

          const container = document.getElementById('clerk-auth');

          if (Clerk.user) {
            container.innerHTML =
              '<span>Signed in as ' + (Clerk.user.firstName || Clerk.user.emailAddresses[0].emailAddress) +
  '</span>' +
              ' &nbsp; <button onclick="Clerk.signOut(() => window.location.reload())">Sign Out</button>';
          } else {
            container.innerHTML =
              '<button onclick="Clerk.openSignIn()">Sign In</button>';
          }
        });
      </script>
    </body>
  </html>